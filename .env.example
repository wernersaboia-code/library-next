# Supabase — papel da aplicação (sem BYPASSRLS)
POSTGRES_URL="postgresql://book_app:senha@db.projeto.supabase.co:6543/postgres"
# Supabase — papel owner, só para migrations e scripts
POSTGRES_MIGRATION_URL="postgresql://postgres:senha@db.projeto.supabase.co:5432/postgres"

SUPABASE_URL="https://projeto.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="chave-service-role-nunca-no-cliente"

# Supabase Auth — a anon key é pública por design (só o service role acima
# fica restrito ao servidor).
NEXT_PUBLIC_SUPABASE_URL="https://projeto.supabase.co"
# Aceita tanto o nome antigo (ANON_KEY) quanto o novo (PUBLISHABLE_KEY) do painel Supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY="chave-anon-publica"
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="chave-publishable-alternativa"

GOOGLE_TRANSLATE_API_KEY=""
TRANSLATE_HOURLY_LIMIT="200"
DRIVE_CACHE_MAX_BYTES="52428800"
