# Supabase — papel da aplicação (sem BYPASSRLS).
# Use o Pooler (Supavisor), não o host direto `db.<ref>.supabase.co`: o direto
# é IPv6-only em projetos novos e falha em redes sem IPv6. Formato do usuário
# no pooler: `<papel>.<project-ref>`. Porta 6543 = transaction (app);
# 5432 = session (migrations/scripts com DDL).
POSTGRES_URL="postgresql://book_app.<ref>:senha@aws-0-<regiao>.pooler.supabase.com:6543/postgres"
# Supabase — papel owner, só para migrations e scripts
POSTGRES_MIGRATION_URL="postgresql://postgres.<ref>:senha@aws-0-<regiao>.pooler.supabase.com:5432/postgres"

SUPABASE_URL="https://projeto.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="chave-service-role-nunca-no-cliente"

# Supabase Auth — a anon key é pública por design (só o service role acima
# fica restrito ao servidor).
NEXT_PUBLIC_SUPABASE_URL="https://projeto.supabase.co"
# Aceita tanto o nome antigo (ANON_KEY) quanto o novo (PUBLISHABLE_KEY) do painel Supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY="chave-anon-publica"
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="chave-publishable-alternativa"

GOOGLE_TRANSLATE_API_KEY=""
TRANSLATE_HOURLY_LIMIT="200"
DRIVE_CACHE_MAX_BYTES="52428800"

# Dono do acervo: usado pelos scripts locais (db:sync-files) quando o
# --email= não é passado. Evita ter que repetir o e-mail a cada execução.
OWNER_EMAIL="voce@exemplo.com"
# Pasta da biblioteca do Calibre (a que contém o metadata.db). Se definida,
# o --path dos scripts fica opcional.
# CALIBRE_PATH="C:\\Livros\\Calibre Portable\\Calibre Library"

# Limite total (bytes) de arquivos de leitura no bucket book-files.
# Padrão do código: 500MB — o plano Free do Supabase dá 1GB de Storage e as
# capas também contam. Suba ao migrar para o Pro (100GB).
BOOK_FILES_MAX_BYTES="524288000"
# Limite (bytes) por arquivo de leitura. 50MB é o máximo de upload por
# arquivo no plano Free do Supabase.
BOOK_FILE_MAX_BYTES="52428800"
